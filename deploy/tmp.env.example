# TMP 运行配置（systemd EnvironmentFile 格式：KEY=VALUE，不要写 export）
# 修改后执行：systemctl restart tmp

# HTTP 监听地址。0.0.0.0 表示所有网卡；只想本机访问用 127.0.0.1:8080
TMP_ADDR=:8080

# 运行数据目录（存放 secret.key 与日志线索）
TMP_DATA_DIR=__TMP_PREFIX__/data

# SQLite 元数据库文件
TMP_DB=__TMP_PREFIX__/data/tmp.db

# 主密钥。留空则首次启动自动生成 __TMP_PREFIX__/data/secret.key（0600）
# 若指定，请使用足够长的随机串；该值同时用于 JWT 签名与集群凭据加密
#TMP_SECRET=

# 演示模式：true 时使用内置假集群，无需真实 TiDB（默认 false）
#TMP_MOCK=false

# gin 运行模式：release / debug
TMP_GIN_MODE=release

# 日志级别：debug / info / warn / error（JSON 输出到 stdout，由 journald 收集）
TMP_LOG_LEVEL=info
